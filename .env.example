# Database — di dev: docker compose up db; di VPS: layanan `db` di compose.yml
DATABASE_URL=postgres://run:runpass@localhost:5432/run_dashboard

# Auth.js — WAJIB dibuat: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-hasil-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Di produksi ganti AUTH_URL=https://run-management.domain-anda.com

# Migrasi otomatis saat container start (1 = jalankan drizzle push + seed jika kosong)
RUN_MIGRATIONS_ON_START=1
